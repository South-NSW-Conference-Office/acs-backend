# deploy/.env.backend.example — copy to /home/morpheus/adventist-community-services/.env.backend
# on morpheus (prod) for the production deploy, or to
# /home/morpheus/adventist-community-services-staging/.env.backend (staging) with the
# staging values noted inline. Gitignored; CI never writes this file, chmod 600.

NODE_ENV=production
PORT=5000

# --- Mongo (host-resident on morpheus; container reaches it via the docker
# gateway — extra_hosts maps host.docker.internal -> the host bridge IP).
# Same `adminbem` credential already used by morpheustools/cfodashboard on
# this host. PROD uses db `adventistcommunityservices`, STAGING uses
# `adventistcommunityservices-staging` — nothing else differs about the URI.
MONGO_URI=mongodb://adminbem:CHANGEME@host.docker.internal:27017/adventistcommunityservices?tls=true&tlsAllowInvalidCertificates=true&authSource=admin
MONGODB_URI=mongodb://adminbem:CHANGEME@host.docker.internal:27017/adventistcommunityservices?tls=true&tlsAllowInvalidCertificates=true&authSource=admin

# --- Public hostnames --------------------------------------------------------
# PROD:    ADMIN_URL/FRONTEND_URL = https://admin.communityservices.org.au
# STAGING: ADMIN_URL/FRONTEND_URL = https://staging-admin.communityservices.org.au
#          also add EXTRA_CORS_ORIGINS=https://staging.communityservices.org.au,https://staging-admin.communityservices.org.au
ADMIN_URL=https://admin.communityservices.org.au
FRONTEND_URL=https://admin.communityservices.org.au

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=CHANGEME

# --- Email (Gmail SMTP) -------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=support@adventhub.org
EMAIL_PASSWORD=CHANGEME
EMAIL_FROM=support@adventhub.org
EMAIL_FROM_NAME=Adventist Community Services

# --- Google OAuth / Maps -------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=CHANGEME
GOOGLE_MAPS_API_KEY=CHANGEME

# --- Wasabi (S3-compatible) storage --------------------------------------------
WASABI_ACCESS_KEY_ID=CHANGEME
WASABI_SECRET_ACCESS_KEY=CHANGEME
WASABI_REGION=ap-southeast-2
WASABI_ENDPOINT=https://s3.ap-southeast-2.wasabisys.com
WASABI_BUCKET=adventistcommunityservices
WASABI_FORCE_PATH_STYLE=true
WASABI_MAX_RETRIES=3
WASABI_TIMEOUT=30000
